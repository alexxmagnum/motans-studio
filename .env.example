# Motans Studio — public site (static export)
# Copy to `.env.local` for local development.

# REQUIRED for production lead capture.
# Public API base URL (no trailing slash). Example: https://api.motans.studio
# Endpoints used:
#   POST {NEXT_PUBLIC_API_URL}/api/public/leads
#   POST {NEXT_PUBLIC_API_URL}/api/public/assisted-requests
# If unset/empty, the form falls back to http://localhost:3002 (dev only)
# and shows a clear connection error pointing to info@motans.studio.
NEXT_PUBLIC_API_URL=

# Canonical site origin (SEO / absolute URLs). Example: https://motans.studio
NEXT_PUBLIC_MS_SITE_ORIGIN=

# Optional MotanOS client panel URL for CTAs (not required for Studio chrome).
NEXT_PUBLIC_MOTANOS_CLIENT_URL=
