# Motans Studio — public site (Next.js App Router)
# Copy to `.env.local` for local development.

# ── Contact form (Resend) — REQUIRED in production ──────────────────────────
# Create an API key at https://resend.com/api-keys
# Never expose this key to the browser (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=

# Optional. Verified sender in Resend.
# Local/dev without a domain: leave empty to use Resend's onboarding@resend.dev
# Production: e.g. Motans Studio <hola@motansstudio.com> (domain must be verified)
RESEND_FROM_EMAIL=

# ── Cloudflare Turnstile (spam protection) ──────────────────────────────────
# Create a widget at https://dash.cloudflare.com → Turnstile
# Site key is public; secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical site origin (SEO / absolute URLs). Default: https://www.motansstudio.com
NEXT_PUBLIC_MS_SITE_ORIGIN=https://www.motansstudio.com

# Optional MotanOS client panel URL for CTAs (not required for Studio chrome).
NEXT_PUBLIC_MOTANOS_CLIENT_URL=

# Optional legacy external API (assisted requests only — not used by the home contact form).
# NEXT_PUBLIC_API_URL=
