# Motans Studio — public site (static export)
# Copy to `.env.local` for local development.

# REQUIRED for production lead capture.
# Public API base URL (no trailing slash). Example: https://api.motansstudio.com
# Endpoints used:
#   POST {NEXT_PUBLIC_API_URL}/api/public/leads
#   POST {NEXT_PUBLIC_API_URL}/api/public/assisted-requests
# If unset in development, forms fall back to http://localhost:3002.
# In production builds, missing API URL disables form submission and points to
# the official contact email (inf.motans@gmail.com).
NEXT_PUBLIC_API_URL=

# Canonical site origin (SEO / absolute URLs). Default: https://www.motansstudio.com
NEXT_PUBLIC_MS_SITE_ORIGIN=https://www.motansstudio.com

# Optional MotanOS client panel URL for CTAs (not required for Studio chrome).
NEXT_PUBLIC_MOTANOS_CLIENT_URL=
